{
  "name": "Driver",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "license_number": {
      "type": "string",
      "title": "License Number"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "assigned_vehicle_id": {
      "type": "string",
      "title": "Assigned Vehicle ID"
    },
    "user_email": {
      "type": "string",
      "title": "User Email"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": ["active", "inactive", "on_trip"],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": ["name", "license_number", "phone"]
}


{
  "name": "HandoverCheck",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "title": "Trip ID"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "driver_name": {
      "type": "string",
      "title": "Driver Name"
    },
    "check_type": {
      "type": "string",
      "title": "Check Type",
      "enum": ["pre_trip", "post_trip"]
    },
    "odometer": {
      "type": "number",
      "title": "Odometer (km)"
    },
    "fuel_level": {
      "type": "string",
      "title": "Fuel Level",
      "enum": ["full", "3/4", "1/2", "1/4", "empty"]
    },
    "condition_notes": {
      "type": "string",
      "title": "General Condition Notes"
    },
    "tire_fl_serial": {
      "type": "string",
      "title": "Tire FL Serial"
    },
    "tire_fr_serial": {
      "type": "string",
      "title": "Tire FR Serial"
    },
    "tire_rl_serial": {
      "type": "string",
      "title": "Tire RL Serial"
    },
    "tire_rr_serial": {
      "type": "string",
      "title": "Tire RR Serial"
    },
    "mismatches_flagged": {
      "type": "boolean",
      "title": "Mismatches Flagged",
      "default": false
    },
    "mismatch_details": {
      "type": "string",
      "title": "Mismatch Details"
    },
    "mismatch_explanation": {
      "type": "string",
      "title": "Mismatch Explanation"
    },
    "signed_off_at": {
      "type": "string",
      "title": "Signed Off At"
    }
  },
  "required": ["trip_id", "vehicle_id", "driver_name", "check_type"]
}

{
  "name": "MaintenanceSchedule",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "name": {
      "type": "string",
      "title": "Service Name"
    },
    "interval_type": {
      "type": "string",
      "title": "Interval Type",
      "enum": ["km", "time"]
    },
    "interval_value": {
      "type": "number",
      "title": "Interval Value"
    },
    "interval_unit": {
      "type": "string",
      "title": "Time Unit",
      "enum": ["days", "weeks", "months"]
    },
    "last_done_date": {
      "type": "string",
      "format": "date",
      "title": "Last Done Date"
    },
    "last_done_mileage": {
      "type": "number",
      "title": "Last Done Mileage (km)"
    },
    "next_due_date": {
      "type": "string",
      "format": "date",
      "title": "Next Due Date"
    },
    "next_due_mileage": {
      "type": "number",
      "title": "Next Due Mileage (km)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": ["ok", "due_soon", "overdue"],
      "default": "ok"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": ["vehicle_id", "name", "interval_type", "interval_value"]
}

{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Type",
      "enum": ["garage", "dispatch", "vehicle", "users", "maintenance"]
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "related_id": {
      "type": "string",
      "title": "Related Record ID"
    },
    "related_type": {
      "type": "string",
      "title": "Related Record Type"
    },
    "severity": {
      "type": "string",
      "title": "Severity",
      "enum": ["info", "warning", "critical"],
      "default": "info"
    },
    "is_read": {
      "type": "boolean",
      "title": "Is Read",
      "default": false
    },
    "recipient_roles": {
      "type": "string",
      "title": "Recipient Roles (comma-separated)"
    },
    "vehicle_plate": {
      "type": "string",
      "title": "Vehicle Plate"
    }
  },
  "required": ["type", "title", "message"]
}


{
  "name": "ServiceItem",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "title": "Session ID"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "item_name": {
      "type": "string",
      "title": "Item Name"
    },
    "action": {
      "type": "string",
      "title": "Action",
      "enum": ["replaced", "repaired", "checked", "adjusted"]
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_part_replacement": {
      "type": "boolean",
      "title": "Is Part Replacement",
      "default": false
    },
    "old_serial": {
      "type": "string",
      "title": "Old Part Serial"
    },
    "old_condition": {
      "type": "string",
      "title": "Old Part Condition"
    },
    "old_removal_reason": {
      "type": "string",
      "title": "Reason Removed"
    },
    "new_serial": {
      "type": "string",
      "title": "New Part Serial"
    },
    "new_brand": {
      "type": "string",
      "title": "New Part Brand"
    },
    "new_condition": {
      "type": "string",
      "title": "New Part Condition at Install"
    },
    "part_position": {
      "type": "string",
      "title": "Position",
      "enum": [
        "front-left",
        "front-right",
        "rear-left",
        "rear-right",
        "spare",
        "n/a"
      ]
    }
  },
  "required": ["session_id", "vehicle_id", "item_name", "action"]
}


{
  "name": "ServiceRecommendation",
  "type": "object",
  "properties": {

{
  "name": "ServiceRecommendation",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "mechanic_name": {
      "type": "string",
      "title": "Mechanic Name"
    },
    "recommendations": {
      "type": "string",
      "title": "Recommendations"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": ["low", "medium", "high", "urgent"],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Suggested Due Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": ["pending", "acknowledged", "done"],
      "default": "pending"
    }
  },
  "required": ["vehicle_id", "mechanic_name", "recommendations"]
}

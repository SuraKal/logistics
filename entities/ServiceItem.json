{
  "name": "ServiceItem",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "title": "Session ID"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "item_name": {
      "type": "string",
      "title": "Item Name"
    },
    "action": {
      "type": "string",
      "title": "Action",
      "enum": ["replaced", "repaired", "checked", "adjusted"]
    },
    "notes": {
      "type": "string",
      "title": "Note"
    },
    "is_part_replacement": {
      "type": "boolean",
      "title": "This is a part replacement"
    }
  },
  "required": ["session_id", "vehicle_id", "item_name", "action"]
}

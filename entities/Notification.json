{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Type",
      "enum": ["garage", "dispatch", "vehicle", "users", "maintenance"]
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "related_id": {
      "type": "string",
      "title": "Related Record ID"
    },
    "related_type": {
      "type": "string",
      "title": "Related Record Type"
    },
    "severity": {
      "type": "string",
      "title": "Severity",
      "enum": ["info", "warning", "critical"],
      "default": "info"
    },
    "is_read": {
      "type": "boolean",
      "title": "Is Read",
      "default": false
    },
    "recipient_roles": {
      "type": "string",
      "title": "Recipient Roles (comma-separated)"
    },
    "vehicle_plate": {
      "type": "string",
      "title": "Vehicle Plate"
    }
  },
  "required": ["type", "title", "message"]
}

{
  "name": "TripStop",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "title": "Trip ID"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "stop_time": {
      "type": "string",
      "title": "Time"
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "enum": [
        "fuel_stop",
        "breakdown",
        "flat_tire",
        "rest",
        "delivery",
        "pickup",
        "other"
      ]
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "logged_by": {
      "type": "string",
      "title": "Logged By"
    }
  },
  "required": ["trip_id", "location", "reason"]
}
